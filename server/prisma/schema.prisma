// ============================================================
// My-Notebook — Prisma Schema (OOP Reconstruction — Phase 0)
// PostgreSQL stores ONLY login credentials & drive account refs.
// All content (notes, files, folders) lives in user's Google Drive.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User: login credentials only ────────────────────────────
model User {
  id           String         @id @default(cuid())
  email        String         @unique
  username     String
  passwordHash String
  drives       UserDrive[]
  sharedLinks  SharedLink[]
  activityLogs ActivityLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("users")
}

// ─── UserDrive: one row per connected Gmail/Drive account ─────
model UserDrive {
  id                    String  @id @default(cuid())
  userId                String
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  gmailAccount          String          // e.g. "yash@gmail.com"
  encryptedRefreshToken String @db.Text // AES-256 encrypted refresh token

  isPrimary             Boolean @default(false) // first drive added = primary
  isActive              Boolean @default(true)

  // Quota info — synced periodically from Drive API
  spaceUsed             BigInt @default(0) // bytes used
  spaceTotal            BigInt @default(0) // total quota (15 GB free tier)

  // GDrive folder IDs — set after Drive structure is initialised on signup
  rootFolderId          String? // ID of "My-Notebook/" folder in this Drive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gmailAccount])
  @@map("user_drives")
}

// ─── ActivityLog: user-visible audit trail ───────────────────
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  action     String   // "create-folder" | "upload-file" | "create-note" | "save-note" | "delete-file" | "add-drive" | "update-username"
  targetName String   // human-readable name of the thing acted on
  targetId   String?  // Drive file/folder id or UserDrive id
  details    String?  // optional extra context (free text)

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ─── SharedLink: tokenised read-only sharing ──────────────────
model SharedLink {
  id          String @id @default(cuid())
  token       String @unique

  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  driveAccountId String // Foreign Key to UserDrive.id
  driveFileId    String // Google Drive file ID of the shared note

  expiresAt DateTime?
  viewCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shared_links")
}
